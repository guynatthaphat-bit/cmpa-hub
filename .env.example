# =========================================================================
# CMPA Hub — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ครบ
#
# 📍 Render Deployment:
#   ค่าส่วนใหญ่ตั้งใน render.yaml แล้ว (auto-generate หรือ inject)
#   มี 6 ค่าที่ต้องตั้งเองใน Render Dashboard → Environment:
#     1. NEXTAUTH_URL           (หลังได้ URL จาก Render)
#     2. ADMIN_INITIAL_PASSWORD (ตั้งรหัสผ่านครั้งแรก)
#     3. ANTHROPIC_API_KEY      (ขอจาก console.anthropic.com)
#     4. LINE_CHANNEL_ACCESS_TOKEN  (ถ้าใช้ LINE)
#     5. LINE_CHANNEL_SECRET    (ถ้าใช้ LINE)
#     6. R2_*                   (ถ้าเปิด R2 backup)
# =========================================================================

# -------- Database --------
# Local Docker dev: ใช้ host.docker.internal
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://cmpa:CHANGE_ME_DB_PASSWORD@host.docker.internal:5432/cmpa?schema=public"
DB_PASSWORD="CHANGE_ME_DB_PASSWORD"
# Render: auto-injected by render.yaml (ไม่ต้องตั้งเอง)

# -------- Next.js / Auth.js --------
# Generate ด้วย: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32"
# Render: เปลี่ยนเป็น URL จาก Render เช่น https://cmpa-hub.onrender.com
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="production"
# Render: ต้องตั้ง = "true" (อยู่หลัง reverse proxy)
AUTH_TRUST_HOST="true"

# -------- AI (Anthropic) --------
# ขอ API key ที่ https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-CHANGE_ME"
# Default model สำหรับ chat + OCR
ANTHROPIC_MODEL="claude-sonnet-4-6"

# -------- Paperclip AI bridge (Phase 2+) --------
# ใส่ port ที่ Paperclip listen — ตรวจด้วย: ss -tlnp | grep node
PAPERCLIP_URL="http://host.docker.internal:7860"
PAPERCLIP_ENABLED="false"

# -------- LINE Notify (Phase 3+) --------
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""

# -------- Initial admin user (seed) --------
ADMIN_EMAIL="natthaphat@cmpa.or.th"
ADMIN_INITIAL_PASSWORD="CHANGE_ME_ON_FIRST_LOGIN"
ADMIN_FIRST_NAME="ฐานพัฒน์"
ADMIN_LAST_NAME="สิริโชติพิพัฒ"

# -------- Storage --------
# ⚠️ Render filesystem เป็น EPHEMERAL - ไฟล์จะหายเมื่อ deploy/restart
# Production บน Render: เปิด R2 backup ด้านล่าง หรือใช้ disk (paid plan ขึ้นไป)
STORAGE_PATH="/var/cmpa/storage"
MAX_UPLOAD_SIZE_MB="25"

# -------- Encryption (pgcrypto) --------
# Generate ด้วย: openssl rand -hex 32
FIELD_ENCRYPTION_KEY="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32"

# -------- Logging --------
LOG_LEVEL="info"           # trace | debug | info | warn | error | fatal

# -------- Feature flags --------
FEATURE_PUSH_NOTIFICATIONS="false"
FEATURE_R2_BACKUP="false"

# -------- Cloudflare R2 (แนะนำเปิดเมื่อ deploy บน Render) --------
# ขอ credentials ที่ dash.cloudflare.com → R2 → Manage R2 API Tokens
# ฟรี 10GB + ไม่มี egress fees
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
